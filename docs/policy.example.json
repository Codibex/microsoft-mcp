{
  // Template for the ADMIN-OWNED policy.json (copy to the system location, do NOT
  // keep a restrictive copy next to the binary on dev machines - the server
  // refuses to start with a user-writable restrictive policy).
  //
  // This file is the ONLY source for these settings: Messaging__* env vars and
  // user-secrets are deliberately ignored (mcp.json is user-writable).
  // Comments and trailing commas are allowed.
  "requireInternalRecipients": true,
  "allowedRecipientDomains": ["firma.de", "tochter.firma.de"],
  "aiDisclosureEnabled": true,
  "aiDisclosureText": "Hinweis: Dieser Entwurf wurde von einer KI erstellt und muss vor dem Versand geprüft werden."
}
