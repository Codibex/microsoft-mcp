{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: TenantId + ClientId aus deiner Entra-App eintragen.
  // Die App braucht die Delegated-Permissions Tasks.Read + Tasks.ReadWrite
  // (inkl. der .Shared-Varianten fuer freigegebene Listen).
  // Secrets gehoeren NICHT hierher, sondern in User-Secrets oder Env-Vars.
  // Der Host bietet kein Loeschen an (nur add + complete).
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "DelegatedScopes": ["Tasks.Read", "Tasks.ReadWrite", "Tasks.Read.Shared", "Tasks.ReadWrite.Shared"],
    "EnableTokenCache": true,
    "FallbackToMemoryTokenCache": true,
    "TokenCacheTimeoutSeconds": 10,
    "UnsafeAllowUnencryptedTokenCache": false,
    "AppCredential": "ClientSecret"
  }
}
