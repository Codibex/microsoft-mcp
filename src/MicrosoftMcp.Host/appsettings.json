{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: TenantId + ClientId aus deiner Entra-App eintragen.
  // Secrets gehoeren NICHT hierher, sondern in User-Secrets oder Env-Vars.
  // Domänenwahl: --servers outlook,onedrive,calendar,teams (oder MCP_SERVERS).
  // Ohne Angabe sind alle aktiv. Angeforderte Scopes folgen der Auswahl,
  // ausser Graph:DelegatedScopes wird explizit gesetzt.
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "EnableTokenCache": true,
    "AppCredential": "ClientSecret"
  }
}
