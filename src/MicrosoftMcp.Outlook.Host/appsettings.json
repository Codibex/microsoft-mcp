{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: nur TenantId + ClientId aus deiner Entra-App eintragen
  // (Rezept A, delegiert). Secrets gehoeren NICHT hierher,
  // sondern in User-Secrets oder Env-Vars (siehe README).
  // Enterprise messaging policy (allowed recipient domains, AI disclosure)
  // does NOT live here: it is read from the admin-owned policy.json only
  // (system path or next to the binary), see docs/outlook.md section 10.
  // Messaging__* env vars are ignored by design (mcp.json is user-writable).
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    // Rezept B (App-Only) stattdessen:
    // "AuthMode": "AppOnly",
    // "UserIdOrUpn": "postfach@example.com",
    // Secret via: dotnet user-secrets set "Graph:ClientSecret" "<secret>"
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "DelegatedScopes": ["Mail.Read", "Mail.ReadWrite"],
    "EnableTokenCache": true,
    "FallbackToMemoryTokenCache": true,
    "TokenCacheTimeoutSeconds": 10,
    "UnsafeAllowUnencryptedTokenCache": false,
    "AppCredential": "ClientSecret"
  }
}
