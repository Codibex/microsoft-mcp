{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: TenantId + ClientId aus deiner Entra-App eintragen.
  // Die App braucht fuer Lesen die Delegated-Permission Calendars.Read und
  // fuer Create/Update zusaetzlich Calendars.ReadWrite.
  // Secrets gehoeren NICHT hierher, sondern in User-Secrets oder Env-Vars.
  // Der dedizierte Calendar-Host erfordert Delegated Auth; App-Only wird abgelehnt.
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "DelegatedScopes": ["Calendars.Read", "Calendars.ReadWrite"],
    "EnableTokenCache": true,
    "FallbackToMemoryTokenCache": true,
    "TokenCacheTimeoutSeconds": 10,
    "UnsafeAllowUnencryptedTokenCache": false,
    "AppCredential": "ClientSecret"
  }
}
