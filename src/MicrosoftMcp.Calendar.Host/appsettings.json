{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: TenantId + ClientId aus deiner Entra-App eintragen.
  // Die App braucht die Delegated-Permission Calendars.Read.
  // Secrets gehoeren NICHT hierher, sondern in User-Secrets oder Env-Vars.
  // Read-only host: es gibt keine Schreib-Tools, App-Only ist moeglich
  // (UserIdOrUpn + ClientSecret), solange die Mailbox erreichbar ist.
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "DelegatedScopes": ["Calendars.Read"],
    "EnableTokenCache": true,
    "AppCredential": "ClientSecret"
  }
}
