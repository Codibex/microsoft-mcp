{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // Template: TenantId + ClientId aus deiner Entra-App eintragen.
  // Die App braucht die Delegated-Permissions Sites.Read.All + Files.Read +
  // Files.ReadWrite (fuer Teams-Kanalbibliotheken zusaetzlich die Scopes aus
  // teams.md, wenn beide Server gemeinsam laufen).
  // Secrets gehoeren NICHT hierher, sondern in User-Secrets oder Env-Vars.
  "Graph": {
    "AuthMode": "Delegated",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-CLIENT-ID",
    "UserIdOrUpn": "me",
    "DelegatedFlow": "Auto",
    "DelegatedScopes": ["Sites.Read.All", "Files.Read", "Files.ReadWrite"],
    "EnableTokenCache": true,
    "FallbackToMemoryTokenCache": true,
    "TokenCacheTimeoutSeconds": 10,
    "UnsafeAllowUnencryptedTokenCache": false,
    "AppCredential": "ClientSecret"
  }
}
